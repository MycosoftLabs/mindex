  "http_contract": {
    "method": "GET",
    "route": "/taxa",
    "filters": {
      "family": "Exact resolved displayed family: nonblank core metadata, otherwise the first exact validated FungiP family in species_id order, otherwise Unknown; filter, sort, and row projection use the same scalar.",
      "category": [
        "all",
        "edible",
        "medicinal",
        "poisonous",
        "psychoactive",
        "gourmet",
        "unknown"
      ],
      "filter": [
        "all",
        "has_images",
        "has_description"
      ],
      "order_by": [
        "server",
        "canonical_name",
        "name-asc",
        "name-desc",
        "observations",
        "observations_count",
        "obs_count",
        "family",
        "featured"
      ]
    },
    "pagination": "pagination.total is the filtered count before limit/offset; it uses a 300-second TTL cache and may lag current page membership. query.count_cache_state and query.count_consistency qualify freshness; ordinary browsing excludes merged rows while explicit IDs retain direct-lookup behavior; current max_page_size applies; no 500 cap added",
    "status": [
      "available",
      "empty",
      "partial",
      "unavailable"
    ],
    "unavailable_behavior": "HTTP 503 for core failure or for a nonempty source-dependent page when required FungiP enrichment fails; a genuine zero-match result remains empty",
    "unsupported_behavior": "HTTP 422 with field-level detail",
    "family_projection": {
      "resolution_order": [
        "nonblank core.taxon.metadata.family",
        "first exact validated fungip.species record family by species_id",
        "Unknown"
      ],
      "filter_sort_and_display_share_value": true,
      "evidence_source_order": [
        "core.taxon.metadata.family",
        "fungip.species.record.taxonomy.family"
      ],
      "max_evidence_entries": 2,
      "max_value_chars": 200,
      "max_species_id_chars": 64
    },
    "category_evidence": {
      "max_entries": 64,
      "max_value_chars": 120,
      "allowed_categories": [
        "edible",
        "medicinal",
        "poisonous",
        "psychoactive",
        "gourmet"
      ],
      "allowed_sources": [
        "core.taxon.metadata.edibility",
        "core.taxon.metadata.characteristics",
        "bio.taxon_trait",
        "bio.taxon_characteristic"
      ],
      "projected_only_for_explicit_category_pages": true
    },
    "image_projection": {
      "max_url_chars": 2048,
      "max_source_url_chars": 2048,
      "max_attribution_chars": 512,
      "max_license_code_chars": 128,
      "selection_and_filter_use_same_usable_url_rules": true,
      "url_credit_license_are_paired_to_selected_source": true
    },
    "query_metadata": {
      "contract_version": "mycosoft.mindex.ancestry.filtered-catalog.v2",
      "count_scope": "matching_core_taxa",
      "count_consistency": "best_effort_not_atomic",
      "count_cache_state": [
        "fresh_query",
        "cache_hit"
      ],
      "count_cache_ttl_seconds": 300,
      "count_note": "A cache hit can be stale relative to the returned page; consumers must not present it as an exact count of the current rows. Existing PostgreSQL ILIKE wildcard behavior for lineage_contains is preserved.",
      "empty_status_rule": "empty only when a fresh zero count and no rows are returned; a cached zero paired with rows stays available"
    }
